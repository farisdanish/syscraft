// Database Connection Helper
function getDbConnection(): ?PDO {
    $host = getenv('DB_HOST') ?: 'syscraft-postgres';
    $port = getenv('DB_PORT') ?: '5432';
    $dbname = getenv('DB_DATABASE') ?: 'syscraft_test';
    $user = getenv('DB_USERNAME') ?: 'syscraft_user';
    $pass = getenv('DB_PASSWORD') ?: 'syscraft_secret';

    $dsn = "pgsql:host={$host};port={$port};dbname={$dbname}";
    try {
        $pdo = new PDO($dsn, $user, $pass, [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_TIMEOUT => 5,
        ]);
        return $pdo;
    } catch (PDOException $e) {
        return null;
    }
}

// Ensure Database Tables & Fixtures
function ensureFixtures(PDO $pdo): void {
    // 1. Posts, Authors, Comments
    $pdo->exec("
        CREATE TABLE IF NOT EXISTS authors (
            id SERIAL PRIMARY KEY,
            name VARCHAR(255) NOT NULL
        );
        CREATE TABLE IF NOT EXISTS posts (
            id SERIAL PRIMARY KEY,
            author_id INT REFERENCES authors(id),
            title VARCHAR(255) NOT NULL,
            content TEXT,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        );
        CREATE TABLE IF NOT EXISTS comments (
            id SERIAL PRIMARY KEY,
            post_id INT REFERENCES posts(id),
            body TEXT NOT NULL
        );
    ");

    // Check if 25 posts are seeded for accurate query budget testing (1 + 25 + 25 = 51 queries)
    $stmt = $pdo->query("SELECT COUNT(*) as count FROM posts");
    if ((int)$stmt->fetch()['count'] < 25) {
        $pdo->exec("TRUNCATE TABLE comments, posts, authors RESTART IDENTITY CASCADE;");
        $pdo->exec("
            INSERT INTO authors (id, name) VALUES 
                (1, 'Ahmad Zaki'), 
                (2, 'Siti Nurhaliza'), 
                (3, 'Tan Sri Lee');
        ");

        $postStmt = $pdo->prepare("INSERT INTO posts (id, author_id, title, content) VALUES (?, ?, ?, ?);");
        $commentStmt = $pdo->prepare("INSERT INTO comments (post_id, body) VALUES (?, ?);");

        for ($i = 1; $i <= 25; $i++) {
            $authorId = (($i - 1) % 3) + 1;
            $postStmt->execute([$i, $authorId, "Architectural Post #{$i}", "Deep-dive systems content for post {$i}"]);
            $commentStmt->execute([$i, "First comment on post #{$i}"]);
            $commentStmt->execute([$i, "Second comment on post #{$i}"]);
        }
    }

    // 2. Weather Observations with 5,000 seeded rows
    $pdo->exec("
        CREATE TABLE IF NOT EXISTS weather_observations (
            id SERIAL PRIMARY KEY,
            station_code VARCHAR(32) NOT NULL,
            temperature_c NUMERIC(4, 1) NOT NULL,
            recorded_at TIMESTAMP NOT NULL
        );
    ");

    $weatherCount = (int)$pdo->query("SELECT COUNT(*) as count FROM weather_observations")->fetch()['count'];
    if ($weatherCount < 5000) {
        $pdo->beginTransaction();
        $insert = $pdo->prepare("
            INSERT INTO weather_observations (station_code, temperature_c, recorded_at)
            VALUES (?, ?, ?)
        ");

        $stations = ['STN-MY-042', 'STN-MY-001', 'STN-MY-088', 'STN-SG-010', 'STN-ID-022'];
        $baseTime = strtotime('2026-01-01 00:00:00');

        for ($i = 0; $i < 5000; $i++) {
            $station = $stations[$i % count($stations)];
            $temp = 24.0 + ($i % 120) * 0.1;
            $time = date('Y-m-d H:i:s', $baseTime + ($i * 600));
            $insert->execute([$station, $temp, $time]);
        }
        $pdo->commit();
        $pdo->exec("ANALYZE weather_observations;");
    }
}

